# Copied to deploy/staging/.env by setup.sh on the SERVER. Never commit .env.
# One KEY=VALUE per line; put values containing spaces, < or $ in single quotes.
# setup.sh generates the four secrets below; fill in the rest with an editor
# on the server (never paste them into chat).

# --- Hostnames (DNS A records must point at this server) ---
RIDER_HOST=staging.captain.et
API_HOST=api.staging.captain.et
STAFF_HOST=staff.staging.captain.et
# Contact address for Let's Encrypt certificate notices.
ACME_EMAIL=

# --- Generated by setup.sh (random, 64 hex chars) ---
POSTGRES_PASSWORD=
API_DB_PASSWORD=
AUTH_SECRET=
INTERNAL_API_TOKEN=

# --- Email OTP via Postmark SMTP (R-92) ---
# Values from the Postmark server's SMTP settings. Some VPS providers block
# port 587 for new accounts; Postmark's SMTP settings list alternatives.
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# A sender address/domain verified in Postmark.
EMAIL_FROM="Captain Staging <no-reply@captain.et>"

# --- STAGING TEST VALUES for unresolved business rules (not decisions) ---
# D-BILLCUT: end_request | completion_confirmed
RIDE_BILLING_CUTOFF=end_request
# D-ENDCONF: none | device_lock (the simulator acknowledges locks)
RIDE_END_CONFIRMATION=device_lock
# D-PARK: off | flag | reject
RIDE_PARKING_POLICY=flag
