# Copy to .env for local runs. Never commit real values.
APP_ENV=development
# info|warn|error|fatal|silent (debug and trace are refused in production)
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3000
# Local cluster from scripts/db-local.sh
DATABASE_URL=postgres://captain@127.0.0.1:54329/captain_dev
# Providers: none | fake/log_only/simulated (development & staging only)
PAYMENT_PROVIDER=none
OTP_SMS_PROVIDER=none
OTP_EMAIL_PROVIDER=none
DEVICE_ADAPTER=none
