# Copy to .env for local runs. Never commit real values.
APP_ENV=development
# info|warn|error|fatal|silent (debug and trace are refused in production)
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3000
# Local cluster from scripts/db-local.sh
DATABASE_URL=postgres://captain@127.0.0.1:54329/captain_dev
# Providers: none | fake/log_only/simulated (development & staging only)
PAYMENT_PROVIDER=none
DEVICE_ADAPTER=none
# --- Authentication (Phase 4) ---
# Required (>= 32 random chars) in staging/production. Never commit a real value.
# AUTH_SECRET=
AUTH_RIDER_CHANNELS=sms,email
OTP_SMS_PROVIDER=log_only
OTP_EMAIL_PROVIDER=log_only
# Browser security. Comma-separated exact origins; required in staging/production.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Must be true (HTTPS) in staging/production; false only for local http.
COOKIE_SECURE=false
TRUST_PROXY=0
# --- Email (only when OTP_EMAIL_PROVIDER=smtp; provider Postmark, R-92:
# host/port/user/password from the Postmark server's SMTP settings) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=Captain <no-reply@captain.et>
# --- Fleet / IoT (Phase 6) ---
# Required (>= 32 random chars) in staging/production; shared with the gateway.
# INTERNAL_API_TOKEN=
COMMAND_TIMEOUT_SECONDS=20
FLEET_TELEMETRY_STALE_SECONDS=300
DEVICE_OFFLINE_SECONDS=120
FLEET_MIN_RIDEABLE_BATTERY=15
FLEET_LOW_BATTERY_PERCENT=20
# --- Wallet / payments (Phase 7) ---
# PAYMENT_PROVIDER=fake is a SIMULATED provider (development/test only; refused in production).
# Chapa is not implemented yet (blocked: official docs unreachable, T-01).
PAYMENT_EXPIRY_MINUTES=60
# Optional upper limit per top-up in santim (unset = no limit). DEV FIXTURE until decided.
# TOPUP_MAX_SANTIM=
# Public base URL of this API (webhook callback) and rider return URL; required in staging/production.
# PUBLIC_API_URL=
# RIDER_RETURN_URL=
REFUNDS_REQUIRE_SECOND_APPROVER=true
# --- Rides (Phase 8) ---
# Unresolved business rules (D-BILLCUT, D-ENDCONF, D-PARK). Unset in development/test =
# DEV FIXTURE fallback (end_request / device_lock / flag); REQUIRED in staging/production.
# RIDE_BILLING_CUTOFF=end_request|completion_confirmed
# RIDE_END_CONFIRMATION=none|device_lock
# RIDE_PARKING_POLICY=off|flag|reject
RIDE_COMPLETION_TIMEOUT_SECONDS=180
