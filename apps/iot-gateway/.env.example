APP_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
HEALTH_PORT=3100
# none | simulated (simulated is refused in production; real supplier adapter is blocked on docs)
DEVICE_ADAPTER=none
API_INTERNAL_URL=http://127.0.0.1:3000
